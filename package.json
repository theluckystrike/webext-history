{
  "name": "@anthropic/webext-history",
  "version": "1.0.0",
  "description": "Typed history helpers for Chrome extensions",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theluckystrike/webext-history.git"
  },
  "keywords": [
    "chrome-extension",
    "history",
    "browser-history",
    "webext"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/theluckystrike/webext-history/issues"
  },
  "homepage": "https://github.com/theluckystrike/webext-history#readme",
  "devDependencies": {
    "@types/chrome": "^0.1.37",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
